# Math - TSL Example
# Demonstrates arithmetic operations

a = 10
b = 3

print(a + b)
print(a - b)
print(a * b)
print(a / b)
print(a % b)

# Complex expressions
result = (10 + 20) * 2
print(result)

# Comparison
print(a > b)
print(a < b)
print(a == 10)
print(a != b)

# Logical operators
print(true and false)
print(true or false)
print(not true)
