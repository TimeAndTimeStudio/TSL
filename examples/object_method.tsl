# Object with Method
function create_point(x, y):
    return {
        x: x,
        y: y,
        distance: function(other):
            dx = other.x - self.x
            dy = other.y - self.y
            return dx * dx + dy * dy
    }

p1 = create_point(0, 0)
p2 = create_point(3, 4)
print(p1.distance(p2))
