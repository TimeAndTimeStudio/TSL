# Graph Adjacency List
function create_graph():
    vertices = []
    edges = []
    
    return {
        add_vertex: function(v):
            vertices[vertices.length] = v
        add_edge: function(v1, v2):
            edges[edges.length] = { from: v1, to: v2 }
        print: function():
            for edge in edges:
                print(edge.from + " -> " + edge.to)
    }

graph = create_graph()
graph.add_vertex("A")
graph.add_vertex("B")
graph.add_vertex("C")
graph.add_edge("A", "B")
graph.add_edge("B", "C")
graph.add_edge("C", "A")
graph.print()
