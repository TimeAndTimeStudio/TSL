# If / Else - TSL Example
# Demonstrates conditional statements

x = 15

if x > 10:
    print("x is greater than 10")
else:
    print("x is 10 or less")

y = 5

if y > 10:
    print("y is greater than 10")
else:
    if y > 0:
        print("y is positive but 10 or less")
    else:
        print("y is zero or negative")

# Nested if
a = 20
b = 30

if a > 10:
    if b > 20:
        print("Both conditions met")
