# Dynamic Programming - Edit Distance
function edit_distance(s1, s2):
    m = 0
    for ch in s1:
        m = m + 1
    
    n = 0
    for ch in s2:
        n = n + 1
    
    dp = []
    i = 0
    while i <= m:
        dp[i] = []
        j = 0
        while j <= n:
            if i == 0:
                dp[i][j] = j
            else if j == 0:
                dp[i][j] = i
            else if s1[i - 1] == s2[j - 1]:
                dp[i][j] = dp[i - 1][j - 1]
            else:
                dp[i][j] = 1 + min(dp[i][j - 1], dp[i - 1][j], dp[i - 1][j - 1])
            j = j + 1
        i = i + 1
    
    return dp[m][n]

function min(a, b, c):
    m = a
    if b < m:
        m = b
    if c < m:
        m = c
    return m

result = edit_distance("kitten", "sitting")
print(result)
