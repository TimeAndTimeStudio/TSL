# Objects - TSL Example
# Demonstrates object creation and member access

# Object creation
player = { x: 100, y: 200, name: "Hero", health: 100 }

print(player.x)
print(player.y)
print(player.name)
print(player.health)

# Object with functions
function create_player(name, px, py):
    return { x: name, px: px, py: py }

hero = create_player("Hero", 0, 0)
print(hero.x)

# Basic object usage
config = { width: 800, height: 600, title: "TSL Game" }

print(config.width)
print(config.height)
print(config.title)

# Empty object
empty = {}
print(empty)
