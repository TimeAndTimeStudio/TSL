function bubble_sort(arr):
    n = length(arr)
    i = 0
    while i < n - 1:
        j = 0
        while j < n - i - 1:
            if arr[j] > arr[j + 1]:
                temp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp
            j = j + 1
        i = i + 1
    return arr

set numbers = [5, 3, 8, 1, 2]
set sorted_numbers = bubble_sort(numbers)
print(sorted_numbers)
