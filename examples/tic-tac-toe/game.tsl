# Tic Tac Toe - TSL with Canvas Rendering
# Uses Engine API: draw_rect, draw_circle, draw_line, clear

# Game state
board = [null, null, null, null, null, null, null, null, null]
current_player = "X"
game_over = false
winner = null

# Canvas coordinates
screen_width = 800
screen_height = 600
board_x = 250
board_y = 100
cell_size = 150

# Helper functions
function get_cell(row, col):
    return board[row * 3 + col]

function set_cell(row, col, value):
    board[row * 3 + col] = value

function check_winner():
    # Check rows
    for row in range(3):
        c0 = get_cell(row, 0)
        c1 = get_cell(row, 1)
        c2 = get_cell(row, 2)
        if c0 != null and c0 == c1 and c1 == c2:
            return c0
    # Check columns
    for col in range(3):
        c0 = get_cell(0, col)
        c1 = get_cell(1, col)
        c2 = get_cell(2, col)
        if c0 != null and c0 == c1 and c1 == c2:
            return c0
    # Check diagonals
    d1 = get_cell(0, 0)
    d2 = get_cell(1, 1)
    d3 = get_cell(2, 2)
    if d1 != null and d1 == d2 and d2 == d3:
        return d1
    d1 = get_cell(0, 2)
    d2 = get_cell(1, 1)
    d3 = get_cell(2, 0)
    if d1 != null and d1 == d2 and d2 == d3:
        return d1
    return null

function is_board_full():
    for i in range(9):
        row = i / 3
        col = i % 3
        if get_cell(row, col) == null:
            return false
    return true

# Drawing functions
function draw_board():
    # Clear screen
    clear()
    
    # Draw grid lines
    # Vertical lines
    for i in range(4):
        x = board_x + i * cell_size
        draw_line(x, board_y, x, board_y + 3 * cell_size)
    
    # Horizontal lines
    for i in range(4):
        y = board_y + i * cell_size
        draw_line(board_x, y, board_x + 3 * cell_size, y)

function draw_x(row, col):
    x = board_x + col * cell_size
    y = board_y + row * cell_size
    margin = 20
    
    # Draw X
    draw_line(x + margin, y + margin, x + cell_size - margin, y + cell_size - margin)
    draw_line(x + cell_size - margin, y + margin, x + margin, y + cell_size - margin)

function draw_o(row, col):
    x = board_x + col * cell_size + cell_size / 2
    y = board_y + row * cell_size + cell_size / 2
    radius = cell_size / 2 - 20
    
    draw_circle(x, y, radius)

function draw_game():
    draw_board()
    
    # Draw cells
    for row in range(3):
        for col in range(3):
            cell = get_cell(row, col)
            if cell == "X":
                draw_x(row, col)
            if cell == "O":
                draw_o(row, col)

function update():
    # Handle input (will be overridden by JS event handlers)
    pass

function draw():
    draw_game()

# Initialize
function init():
    # Setup canvas and event handlers (will be overridden by JS)
    pass

# Run the game
init()
