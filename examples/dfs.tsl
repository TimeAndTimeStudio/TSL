# Depth First Search
function create_graph():
    adj = {}
    
    return {
        add_edge: function(u, v):
            if u not in adj:
                adj[u] = []
            adj[u][adj[u].length] = v
        dfs: function(start):
            visited = {}
            stack = []
            stack[0] = start
            
            while stack.length > 0:
                v = stack[stack.length - 1]
                stack.length = stack.length - 1
                
                if v not in visited:
                    print(v)
                    visited[v] = true
                    
                    i = 0
                    while i < adj[v].length:
                        stack[stack.length] = adj[v][i]
                        i = i + 1
    }

graph = create_graph()
graph.add_edge("A", "B")
graph.add_edge("A", "C")
graph.add_edge("B", "D")
graph.add_edge("C", "E")
graph.dfs("A")
