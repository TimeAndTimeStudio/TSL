# Dynamic Programming - Palindrome Partitioning
function is_palindrome(s):
    i = 0
    j = s.length - 1
    while i < j:
        if s[i] != s[j]:
            return false
        i = i + 1
        j = j - 1
    return true

function min_cut(s):
    n = s.length
    if n == 0:
        return 0
    
    dp = []
    i = 0
    while i < n:
        dp[i] = i
        i = i + 1
    
    i = 1
    while i < n:
        j = 0
        while j <= i:
            if is_palindrome(s.substring(j, i + 1)):
                if j == 0:
                    dp[i] = 0
                else if dp[j - 1] + 1 < dp[i]:
                    dp[i] = dp[j - 1] + 1
            j = j + 1
        i = i + 1
    
    return dp[n - 1]

s = "aab"
result = min_cut(s)
print(result)
